# 复制为 apps/loom/.env 后按需修改。

# fake：分析步骤返回 contracts 夹具，不调用模型（新克隆即可跑通）
# real：调用 LOOM_MODEL 指定的模型
LOOM_AGENT_MODE=fake

# 真实模式必填，Mastra 的 provider/model 字符串，例如 openai/gpt-5.1、anthropic/claude-sonnet-4-5
LOOM_MODEL=
# 对应供应商的 API key（按 LOOM_MODEL 的 provider 填写其一）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 可选：自建或第三方 OpenAI 兼容接口（DeepSeek、通义、Ollama、vLLM、公司网关等），请求发往 <URL>/chat/completions
# 例如 https://api.deepseek.com/v1、http://localhost:11434/v1；留空则使用 LOOM_MODEL 供应商的默认地址
LOOM_MODEL_URL=
# 配合 LOOM_MODEL_URL 的密钥；设置了 LOOM_MODEL_URL 时只读这一项，不再读上面的 *_API_KEY（本地 Ollama 可留空）
# 实际请求的模型名是 LOOM_MODEL 去掉 provider 前缀的部分，例如 alibaba/qwen3-max 发送 qwen3-max
LOOM_MODEL_API_KEY=

# 可选：私有仓库与 GitHub MCP（只读 repos 工具集）
GITHUB_TOKEN=

# 可选：源文件数超过该值时先按顶层目录做模块摘要（默认 400）
LOOM_SPLIT_FILE_THRESHOLD=400
# 可选：单个 Agent 调用的最大步数（默认 12）
LOOM_MAX_STEPS=12
# 可选：假模式下每个分析模拟的耗时（毫秒，默认 0），便于在界面上观察进度与日志
LOOM_FAKE_DELAY_MS=1500
# 可选：服务端控制台日志级别 debug / info / warn / error（默认 info）；运行页的运行日志不受影响
LOOM_LOG_LEVEL=info
# 可选：Loom 数据目录（克隆缓存、报告、数据库），默认仓库根下 .loom
LOOM_DATA_DIR=
