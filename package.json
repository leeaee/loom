{
  "name": "loom",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "concurrently -k -n loom,web -c cyan,magenta \"npm run dev -w @loom/server\" \"npm run dev -w @loom/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "deps:check": "depcruise apps packages scripts --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness:sync": "node scripts/harness-sync.ts",
    "harness:check": "node scripts/harness-sync.ts --check",
    "check": "npm run lint && npm run typecheck && npm run deps:check && npm run test && npm run harness:check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "concurrently": "10.0.6",
    "dependency-cruiser": "18.7.0",
    "lefthook": "2.2.2",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.5"
  }
}
